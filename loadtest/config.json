      "executor": "constant-arrival-rate",
      "rate": 50,
      "duration": "60s",
      "preAllocatedVUs": 50,
      "maxVUs": 500,
      "expect_status": 429,
      "key_models": ["mock-gpt"],
      "key_rpm": 30,
      "key_tpm": 100000000,
      "key_budget": 1000
    },
    {
      "name": "budget",
      "enabled": true,
      "model": "gemini-3.5-flash",
